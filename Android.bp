// libsamsung-ipc for vendor daemons on Shannon modems, as a static library.
// The device is found at run time (device tree compatible).
cc_library_static {
    name: "libsamsung-ipc-shannon",
    vendor: true,
    srcs: ["samsung-ipc/**/*.c"],
    exclude_srcs: ["samsung-ipc/tests/**/*"],
    local_include_dirs: [
        "include",
        "samsung-ipc",
    ],
    export_include_dirs: ["include"],
    shared_libs: ["libcrypto"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
}
