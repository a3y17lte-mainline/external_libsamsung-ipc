// libsamsung-ipc for vendor daemons on Shannon modems (a3y17lte), as a
// static library. The legacy Android.mk (system modules for the older
// devices) is independent of it.
cc_library_static {
    name: "libsamsung-ipc-shannon",
    vendor: true,
    srcs: ["samsung-ipc/**/*.c"],
    exclude_srcs: ["samsung-ipc/tests/**/*"],
    local_include_dirs: [
        "include",
        "samsung-ipc",
    ],
    export_include_dirs: ["include"],
    shared_libs: ["libcrypto"],
    cflags: [
        "-DIPC_DEVICE_NAME=\"a3y17lte\"",
        "-w",
        "-Wno-error",
    ],
}
